# Copia este archivo a `.env.local` y rellena los valores.
# NUNCA subas `.env` ni `.env.local` al repositorio.

# --- Spotify ---
# Crea la app en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el Redirect URI registrado en el dashboard.
# Local:      http://127.0.0.1:3000/api/spotify-callback
# Producción: https://tu-dominio.com/api/spotify-callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify-callback

# Se obtiene una sola vez visitando /api/spotify-auth en desarrollo
# y copiando el token que muestra /api/spotify-callback.
SPOTIFY_REFRESH_TOKEN=

# ID de la playlist que se muestra en /about (opcional; hay un valor por defecto).
SPOTIFY_PLAYLIST_ID=

# --- LinkedIn (opcional) ---
# Si no se define, /api/linkedin-certificates devuelve la lista estática.
LINKEDIN_ACCESS_TOKEN=
